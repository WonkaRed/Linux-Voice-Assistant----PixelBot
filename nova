#!/usr/bin/env bash
# Nova launcher — push-to-talk voice bridge to the Hermes agents on 10.0.0.75.
#   ./nova                    run the bridge (F4 = pixelbot, F8 = jailbreak)
#   ./nova login              one-time Telegram user login
#   ./nova setup              list bot chats to configure agents
#   ./nova ask <agent> <text> one-shot: send text, speak the reply
set -euo pipefail
cd "$(dirname "$0")"
HERE="$PWD"

# Telegram *user* API credentials (api_id / api_hash) — secrets, never in repo.
SECRETS="$HOME/.claude/secrets/clients/pixel-labs/telegram-user.env"
if [ -f "$SECRETS" ]; then
  set -a; . "$SECRETS"; set +a
fi

# Project virtualenv.
if [ -f ".venv/bin/activate" ]; then
  # shellcheck disable=SC1091
  . ".venv/bin/activate"
fi

# cuDNN / cuBLAS for faster-whisper / CTranslate2. Ask Python where the nvidia
# wheels actually live (the venv uses --system-site-packages, so they're in the
# user site, not under .venv). Robust to path/version changes.
NVIDIA_DIR="$(python3 -c 'import os,nvidia; print(os.path.dirname(nvidia.__file__))' 2>/dev/null || true)"
if [ -n "$NVIDIA_DIR" ]; then
  export LD_LIBRARY_PATH="${NVIDIA_DIR}/cudnn/lib:${NVIDIA_DIR}/cublas/lib:${LD_LIBRARY_PATH:-}"
fi

# Quiet the benign ALSA/JACK startup noise.
export JACK_NO_AUDIO_RESERVATION=1
export JACK_NO_START_SERVER=1

exec python3 "$HERE/src/nova/main.py" "$@"
