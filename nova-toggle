#!/usr/bin/env python3
"""
Toggle recording for an agent by poking the Nova Unix socket.

Bind in COSMIC → Settings → Keyboard → Custom Shortcuts:
    F4  →  <repo>/nova-toggle pixelbot
    F8  →  <repo>/nova-toggle jailbreak
"""
import os
import socket
import subprocess
import sys

agent = sys.argv[1] if len(sys.argv) > 1 else "pixelbot"
sock_path = os.environ.get("NOVA_SOCKET", "/tmp/nova-voice.sock")


def notify(msg):
    try:
        subprocess.Popen(["notify-send", "-t", "1500", "Nova", msg],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception:
        pass


try:
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    s.settimeout(2)
    s.connect(sock_path)
    s.sendall(agent.encode())
    sys.stdout.write(s.recv(128).decode())
    s.close()
except Exception as e:
    notify("Not running")
    sys.stderr.write(f"nova-toggle: {e} (is `nova` running?)\n")
    sys.exit(1)
