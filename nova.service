[Unit]
Description=Nova — voice bridge to the Hermes agents
Documentation=file:///home/wonka/Desktop/Projects/Archived/Dictation/README.md
# Wait for the audio stack and network; the graphical session gives us the
# mic/notify bus. Telethon retries the Telegram connection forever on its own
# (see relay.py), but starting after the network is actually up avoids a
# guaranteed-to-fail first attempt (and the log noise/notification it causes)
# on every boot.
After=pipewire.service pipewire-pulse.service graphical-session.target network-online.target
Wants=pipewire.service network-online.target
# No restart-count ceiling — a persistent failure backs off (via RestartSteps/
# RestartMaxDelaySec below) instead of giving up outright and leaving voice
# dead until someone notices. Mirrors the Hermes gateway units' own policy.
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=%h/Desktop/Projects/Archived/Dictation
ExecStart=%h/Desktop/Projects/Archived/Dictation/nova --daemon
Restart=always
RestartSec=5
RestartSteps=5
RestartMaxDelaySec=300
# Never fight the heretic / model inference for CPU — Nova always yields.
Nice=10
CPUWeight=20
# Keep the STT model resident so recording never stalls paging it back from
# swap (this box runs vm.swappiness=180). ~2 GB, trivially fits in RAM.
MemorySwapMax=0
MemoryLow=1600M

[Install]
WantedBy=default.target
